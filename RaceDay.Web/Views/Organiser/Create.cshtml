@model RaceDay.Web.ViewModels.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Create New Event</h4>
                </div>
                <div class="card-body">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <!--  enctype is required for file uploads -->
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label fw-bold"></label>
                            <input asp-for="EventName" class="form-control" placeholder="e.g., Cape Town Marathon" />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the event..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EventDate" class="form-label fw-bold"></label>
                                <input asp-for="EventDate" class="form-control" type="date" />
                                <span asp-validation-for="EventDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Location" class="form-label fw-bold"></label>
                                <input asp-for="Location" class="form-control" placeholder="e.g., Johannesburg" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Distance" class="form-label fw-bold"></label>
                                <input asp-for="Distance" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="Distance" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="EventType" class="form-label fw-bold"></label>
                                <select asp-for="EventType" class="form-select">
                                    <option value="Run">Run</option>
                                    <option value="Walk">Walk</option>
                                    <option value="Cycle">Cycle</option>
                                </select>
                                <span asp-validation-for="EventType" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MaxParticipants" class="form-label fw-bold"></label>
                                <input asp-for="MaxParticipants" class="form-control" type="number" />
                                <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                            </div>
                        </div>

                        <!--  File Upload Field -->
                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-bold">Event Banner Image (Optional)</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Save Event</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}