@model IEnumerable<RaceDay.Web.ViewModels.OrganiserDashboardViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold text-primary">Organiser Dashboard</h1>
        @if (ViewBag.DebugError != null)
        {
            <div class="alert alert-danger">
                <strong>Debug Error:</strong> @ViewBag.DebugError
            </div>
        }
        <h4 class="text-muted">Welcome back, @ViewBag.Name!</h4>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Total Events</h5>
                    <h2 class="display-4 fw-bold">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Total Enrolments</h5>
                    <h2 class="display-4 fw-bold">@Model.Sum(e => e.TotalEnrollments)</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Events</h5>
                    <h2 class="display-4 fw-bold">@Model.Count(e => e.EventDate > DateTime.Now)</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Events Table -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">My Events</h5>
            <a asp-action="Create" class="btn btn-success btn-sm fw-bold">+ Create New Event</a>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-4 text-center text-muted">
                    <p>You haven't created any events yet. Click "Create New Event" to get started!</p>
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Enrolments</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model)
                        {
                            <tr>
                                <td class="fw-bold">@ev.EventName</td>
                                <td>@ev.EventDate.ToString("MMM dd, yyyy")</td>
                                <td>@ev.Location</td>
                                <td><span class="badge bg-secondary">@ev.EventType</span></td>
                                <td>
                                    <span class="badge bg-info text-dark">@ev.TotalEnrollments / @ev.MaxParticipants</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="ManageCategories" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-primary">Categories</a>
                                        <a asp-action="ViewEnrolments" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-info text-dark">Enrolments</a>

                                        <!-- Delete Button Form -->
                                        <form asp-action="Delete" asp-route-id="@ev.EventID" method="post" onsubmit="return confirm('Are you sure you want to delete this event? All enrolments will be lost.');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>